---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import ProfileCard from "../components/ProfileCard.astro";
import { site } from "../config";
import { getPublishedPosts } from "../lib/posts";

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, 3);
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">PERSONAL SPACE · {new Date().getFullYear()}</p>
      <h1>
        你好，我是 <span>{site.name}</span>。
        <br />
        欢迎来到我的数字花园。
      </h1>
      <p class="hero-lead">
        我在这里记录学习、分享项目，也保存那些值得慢慢想清楚的事。
        不追求喧闹，只希望每一次表达都真诚、有用。
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/blog/">阅读文章 <span>→</span></a>
        <a class="button secondary" href="/projects/">查看项目</a>
      </div>
    </div>

    <div class="hero-note">
      <span class="note-index">01</span>
      <p>{site.status}</p>
      <div class="note-rule"></div>
      <small>STAY HUNGRY · STAY FOOLISH</small>
    </div>
  </section>

  <div class="home-grid">
    <aside class="home-sidebar">
      <ProfileCard postCount={posts.length} />
    </aside>

    <section class="home-feed" aria-labelledby="recent-posts-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">RECENT WRITING</p>
          <h2 id="recent-posts-heading">最近写下的内容</h2>
        </div>
        <a href="/blog/">全部文章 <span aria-hidden="true">→</span></a>
      </div>

      <div class="post-list">
        {
          recentPosts.length > 0 ? (
            recentPosts.map((post) => <PostCard post={post} />)
          ) : (
            <div class="empty-state">
              <p>第一篇文章正在路上。</p>
              <a href="/blog/">前往博客栏目</a>
            </div>
          )
        }
      </div>
    </section>

    <aside class="home-aside">
      <section class="aside-card float-card">
        <p class="eyebrow">CURRENTLY</p>
        <h2>此刻</h2>
        <p>搭建个人网站，整理过去的笔记，并学习如何更清楚地表达。</p>
      </section>

      <section class="aside-card float-card">
        <p class="eyebrow">TOPICS</p>
        <h2>关注 topics</h2>
        <div class="tag-cloud">
          {
            allTags.length > 0 ? (
              allTags.map((tag) => <span>{tag}</span>)
            ) : (
              <>
                <span>学习</span>
                <span>项目</span>
                <span>生活</span>
              </>
            )
          }
        </div>
      </section>

      <section class="quote-card float-card">
        <span aria-hidden="true">“</span>
        <p>写下来，是为了让模糊的思考变得可以看见。</p>
      </section>
    </aside>
  </div>
</BaseLayout>
