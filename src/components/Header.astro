---
import { navigation, site } from "../config";
import SeasonSwitcher from "./SeasonSwitcher.astro";

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label={`${site.title} 首页`}>
    <span class="wordmark-mark">{site.initials}</span>
    <span class="wordmark-text">{site.name}</span>
  </a>

  <nav class="site-nav" aria-label="主要导航">
    {
      navigation.map((item) => (
        <a
          class:list={["nav-link", { active: isActive(item.href) }]}
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="header-actions">
    <SeasonSwitcher />
    <a
      class="header-cta"
      href={site.github}
      target="_blank"
      rel="noreferrer"
    >
      GitHub
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>
