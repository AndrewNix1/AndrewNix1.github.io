---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const date = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(post.data.pubDate);
---

<article class="post-card float-card">
  <a class="post-card-link" href={`/blog/${post.id}/`}>
    <div class="post-card-meta">
      <time datetime={post.data.pubDate.toISOString()}>{date}</time>
      {post.data.featured && <span class="featured-label">精选</span>}
    </div>

    <h3>{post.data.title}</h3>
    <p>{post.data.description}</p>

    <div class="post-card-footer">
      <span>{post.data.tags.join(" · ") || "随笔"}</span>
      <span class="read-more">阅读文章 <span aria-hidden="true">↗</span></span>
    </div>
  </a>
</article>
